# TEMPLATE for .openfable/.env — connection details and secrets.
#
# Write the BASE block plus the block matching the chosen compose template.
# Do not rely on omission: the code defaults are aimed at the hosted server
# deployment, not this stack. In particular OPENFABLE_EMBEDDING_URL defaults to
# https://api.openai.com, so an empty .env sends a local stack to OpenAI and
# fails with 401.
#
# This file holds credentials. Always write .openfable/.gitignore containing
# ".env" alongside it, so a managed-database password cannot be committed.

# ============================================================================
# BASE — always write these
# ============================================================================

# Which host directory is mounted read-only at /work. The compose default is
# the parent of .openfable/, i.e. the project directory. Set an absolute path
# to index documents that live elsewhere.
# OPENFABLE_WORKDIR=/absolute/path/to/documents

# ============================================================================
# DATABASE — write ONE of these
# ============================================================================

# -- all-local.yml, external-embeddings.yml : bundled db service
OPENFABLE_DATABASE_URL=postgresql://openfable:openfable@db:5432/openfable

# -- external-db.yml, external-both.yml : the user's own PostgreSQL
# Managed providers usually require TLS; append ?sslmode=require if so.
# OPENFABLE_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================================================
# EMBEDDINGS — write ONE of these
# ============================================================================

# -- all-local.yml, external-db.yml : bundled TEI service
OPENFABLE_EMBEDDING_URL=http://embeddings:80
OPENFABLE_EMBEDDING_MODEL=BAAI/bge-m3
OPENFABLE_EMBEDDING_API_KEY=
OPENFABLE_EMBEDDING_DIMENSIONS=1024

# -- external-embeddings.yml, external-both.yml : the user's own endpoint
#
# Any OpenAI-compatible /v1/embeddings endpoint. The vector column is fixed at
# 1024 dimensions, so the endpoint MUST return vectors of that length or every
# insert fails. text-embedding-3-small truncates to 1024; -3-large at 3072
# does not fit.
# OPENFABLE_EMBEDDING_URL=https://api.openai.com
# OPENFABLE_EMBEDDING_MODEL=text-embedding-3-small
# OPENFABLE_EMBEDDING_API_KEY=sk-...
# OPENFABLE_EMBEDDING_DIMENSIONS=1024
#
# OpenAI-style providers need a `dimensions` field in the request to truncate.
# TEI serves its native size and rejects unknown fields. This setting does not
# exist in the shipped config yet — see the follow-up on parameterising the
# embedding dimension.
# OPENFABLE_EMBEDDING_SEND_DIMENSIONS=true

# ============================================================================
# RETRIEVAL TUNING — optional, rarely changed
# ============================================================================
# OPENFABLE_RETRIEVAL_TOP_K=10
# OPENFABLE_RETRIEVAL_LLMSELECT_DEPTH=2
